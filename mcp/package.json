{
  "name": "@markasso/mcp",
  "version": "0.4.0",
  "description": "MCP server that lets AI agents create, read and edit Markasso diagrams, offline or live on a shared board",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbertoBarrago/Markasso.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/AlbertoBarrago/Markasso/tree/main/mcp#readme",
  "bugs": "https://github.com/AlbertoBarrago/Markasso/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "markasso",
    "diagram",
    "whiteboard"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "markasso-mcp": "dist/markasso-mcp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "start": "node dist/markasso-mcp.js",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-js": "^2.6.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
