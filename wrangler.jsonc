{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markasso",
  "compatibility_date": "2026-04-07",
  "main": "src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every path the worker answers must be listed: with this option set,
    // anything else is served by the static assets (and the single-page
    // fallback), so a missing prefix breaks that route.
    "run_worker_first": ["/api/*", "/session/*", "/download/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_ROOMS",
        "class_name": "SessionRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionRoom"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SHARE_LINKS",
      "id": "ba266ca029f34cc2998e017067eca662"
    }
  ],
  "ratelimits": [
    {
      "name": "BOARD_RATE_LIMITER",
      "namespace_id": "27081503",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "SHARE_RATE_LIMITER",
      "namespace_id": "27081501",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      // `period` only accepts 10 or 60, so the 10-minute quota the report
      // form actually enforces lives in KV; this binding covers bursts.
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "27081502",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  // Owner setup: pnpm exec wrangler d1 create markasso-boards
  // Owner setup: pnpm exec wrangler r2 bucket create markasso-boards
  "d1_databases": [
    {
      "binding": "BOARDS_DB",
      "database_name": "markasso-boards",
      "database_id": "5be9bbd2-9544-46f5-948a-b42458866139"
    }
  ],
  "r2_buckets": [
    { "binding": "BOARDS_BUCKET", "bucket_name": "markasso-boards" }
  ],
  "vars": {
    "CLOUD_ENABLED": "true",
    "CLOUD_REQUIRES_LICENSE": "true",
    "LIVE_AGENT_REQUIRES_LICENSE": "true",
    "POLAR_BENEFIT_ID": "41f5e208-6182-41d1-9bea-834cc314b4c7",
    "POLAR_ORGANIZATION_ID": "92c40ea2-436a-4363-ac72-9a821ab3e44a",
    "REPORT_REPO": "AlbertoBarrago/markasso"
  },
  "triggers": {
    "crons": ["0 12 * * *"]
  }
}
