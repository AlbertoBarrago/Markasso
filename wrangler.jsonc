{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markasso",
  "compatibility_date": "2026-04-07",
  "main": "src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_ROOMS",
        "class_name": "SessionRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionRoom"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SHARE_LINKS",
      "id": "ba266ca029f34cc2998e017067eca662"
    }
  ],
  "ratelimits": [
    {
      "name": "SHARE_RATE_LIMITER",
      "namespace_id": "27081501",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      // `period` only accepts 10 or 60, so the 10-minute quota the report
      // form actually enforces lives in KV; this binding covers bursts.
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "27081502",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "vars": {
    "REPORT_REPO": "AlbertoBarrago/Markasso"
  },
  "triggers": {
    "crons": ["0 12 * * *"]
  }
}
