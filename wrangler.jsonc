{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markasso",
  "compatibility_date": "2026-04-07",
  "main": "src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_ROOMS",
        "class_name": "SessionRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionRoom"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SHARE_LINKS",
      "id": "ba266ca029f34cc2998e017067eca662"
    }
  ],
  "ratelimits": [
    {
      "name": "BOARD_RATE_LIMITER",
      "namespace_id": "27081503",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "SHARE_RATE_LIMITER",
      "namespace_id": "27081501",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      // `period` only accepts 10 or 60, so the 10-minute quota the report
      // form actually enforces lives in KV; this binding covers bursts.
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "27081502",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  // Owner setup: pnpm exec wrangler d1 create markasso-boards
  // Owner setup: pnpm exec wrangler r2 bucket create markasso-boards
  "d1_databases": [
    {
      "binding": "BOARDS_DB",
      "database_name": "markasso-boards",
      "database_id": "5be9bbd2-9544-46f5-948a-b42458866139"
    }
  ],
  "r2_buckets": [
    { "binding": "BOARDS_BUCKET", "bucket_name": "markasso-boards" }
  ],
  "vars": {
    "CLOUD_ENABLED": "false",
    "CLOUD_REQUIRES_LICENSE": "false",
    "LIVE_AGENT_REQUIRES_LICENSE": "false",
    "REPORT_REPO": "AlbertoBarrago/Markasso"
  },
  "triggers": {
    "crons": ["0 12 * * *"]
  },
  "env": {
    "nightly": {
      "name": "markasso-nightly",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "CLOUD_ENABLED": "true",
        "CLOUD_REQUIRES_LICENSE": "true",
        "LIVE_AGENT_REQUIRES_LICENSE": "true",
        "POLAR_API_URL": "https://sandbox-api.polar.sh",
        "POLAR_BENEFIT_ID": "0a8c91ba-a63c-40a9-bebb-82536ad5dbb3",
        "POLAR_ORGANIZATION_ID": "819b2bb5-7bd5-4d88-99d6-b7cf2efe6b40",
        "REPORT_REPO": "AlbertoBarrago/Markasso"
      },
      "d1_databases": [
        {
          "binding": "BOARDS_DB",
          "database_name": "markasso-nightly-boards",
          "database_id": "7d42221b-5805-4417-b347-9bd89e40de89"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BOARDS_BUCKET",
          "bucket_name": "markasso-nightly-boards"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SESSION_ROOMS",
            "class_name": "SessionRoom"
          }
        ]
      },
      "kv_namespaces": [
        {
          "binding": "SHARE_LINKS",
          "id": "4cef1423e03b489fa3d3dded05a6eb6d"
        }
      ],
      "ratelimits": [
        {
          "name": "BOARD_RATE_LIMITER",
          "namespace_id": "27081603",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "SHARE_RATE_LIMITER",
          "namespace_id": "27081601",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "REPORT_RATE_LIMITER",
          "namespace_id": "27081602",
          "simple": {
            "limit": 3,
            "period": 60
          }
        }
      ]
    }
  }
}
