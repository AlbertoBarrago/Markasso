{
  "name": "markasso",
  "author": "alBz <albertobarrago@gmail.com>",
  "contributors": [
    "Lorenzo Cataldi <lorenzo@cataldi.design>"
  ],
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "pnpm run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage && node scripts/update-badge.mjs",
    "prepare": "husky",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@cloudflare/vite-plugin": "^1.31.0",
    "@cloudflare/workers-types": "^4.20260414.1",
    "@vitest/coverage-v8": "^1.6.1",
    "husky": "^9.1.7",
    "typescript": "^5.4.5",
    "vite": "8.0.5",
    "vitest": "^1.6.0",
    "wrangler": "^4.80.0"
  }
}
