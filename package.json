{
  "name": "markasso",
  "author": "alBz <albertobarrago@gmail.com>",
  "contributors": [
    "Lorenzo Cataldi <lorenzo@cataldi.design>"
  ],
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "pnpm run build && wrangler dev",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "lint": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage && node scripts/update-badge.mjs",
    "prepare": "husky",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@cloudflare/vite-plugin": "^1.43.2",
    "@cloudflare/workers-types": "^5.20260707.1",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "typescript": "^5.4.5",
    "vite": "8.1.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.108.0"
  }
}
